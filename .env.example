# Copy this file to .env for local configuration.
# Gemini API key for the development proxy.
GEMINI_API_KEY=
# Gemini model used by the development proxy.
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated models used when the primary model is unavailable.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-flash-lite-latest
